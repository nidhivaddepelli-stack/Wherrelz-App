@model EntryModel

<br>
<h2>Add Entry</h2>
<br>
<form asp-controller="Entry" asp-action="Create" method="post">
    <div class="modal-body">
        <div class="row">
           
            <div class="col-md-6 mb-6">
                <label asp-for="Account" class="form-label"> Account </label>
                <input asp-for="Account" class="form-control" required />
            </div>

            <div class="col-md-6 mb-6">
                <label asp-for="Currency" class="form-label"> Currency </label>
                <input asp-for="Currency" class="form-control" placeholder="INR" required />
            </div>
        </div>
        <div class="row">

            <div class="col-md-12 mb-12">
                <label asp-for="Narration" class="form-label"> Narration </label>
                <textarea asp-for="Narration" class="form-control"></textarea>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-6">
                <label asp-for="Credit" class="form-label"> Credit </label>
                <input asp-for="Credit"  type="number" step="0.01" class="form-control" />
            </div>

            <div class="col-md-6 mb-6">
                <label asp-for="Debit" class="form-label"> Debit </label>
                <input asp-for="Debit" type="number" step="0.01" class="form-control" />
            </div>
        </div>
        
    </div>

    <br>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancel </button>
        <button type="submit" class="btn btn-primary"> <i class="bi bi-check-circle"></i> Save Entry </button>
    </div>

</form>
