
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="userModal">Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-controller="User" asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="row">
                        <input id="hdnUserId" name="HiddenId" class="form-control" hidden />
                        <div class="col-md-6 mb-3">
                            <label class="form-label"> LoginId </label>
                            <input id="LoginId" name="LoginId" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label"> Name </label>
                            <input id="FullName" name="FullName" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label"> Email </label>
                            <input id="Email" name="Email" class="form-control" />
                        </div>
                        <div id="passwordDiv" class="col-md-6 mb-3">
                            <label class="form-label"> Password </label>
                            <input id="Password" name="Password" class="form-control" />
                        </div>
                        
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancel </button>
                    <button type="submit" class="btn btn-primary"> <i class="bi bi-check-circle"></i> Save User </button>
                </div>

            </form>

        </div>

    </div>

</div>
