@model IEnumerable<UserModel>

 <br>  
<h2>User Entries</h2>
<br>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
         <button type="button" class="close" data-dismiss="alert"> &times; </button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert"> &times; </button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a id="AddEditModel" class="btn btn-primary" href="javascript:void(0);">
        + Add User
    </a>
</div>

<div class="card shadow-sm">

    <div class="card-body">

        <table class="table table-hover">

            <thead class="table-light">
                <tr>
                    <th>LoginId</th>
                    <th>Active Status</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.LoginId</td>
                        <td>@item.IsActive</td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>
                            <a data-id="@item.Id" id="EditUser" class="btn btn-sm btn-outline-primary" title="Edit"> <i class="bi bi-pencil"></i> </a>
                            <a data-id="@item.Id" data-name="@item.FullName" id="deleteUser" class="btn btn-sm btn-outline-danger" title="Delete"> <i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>

@await Html.PartialAsync("_DeleteSoftConfirmation", "UserModel")
@await Html.PartialAsync("_UserAddEditModal", "UserModel")

<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    $(document).on('click', '#AddEditModel', function() {
        $('#hdnUserId').val(0);
        $('#LoginId').val('');
        $('#FullName').val('');
        $('#Email').val('');
        $('#Password').val('');
         $('#userModal').text("Add User")

            $('#addUserModal').modal('show');
    });

    $(document).on('click', '#deleteUser', function() {
        var id = $(this).data("id");
        var fullname = $(this).data("name");

        $("#HiddenId").val(id);
        $("#deleteUserName").text(fullname);
        $('#deleteUserModal').modal('show');
    });

    $(document).on('click', '#EditUser', function() {

        var id = $(this).data('id');

            $.ajax({
            url: '/User/Edit',
            type: 'GET',
            data: { id: id },

            success: function(response) {
                console.log(response);
                $('#hdnUserId').val(response.id);
                $('#LoginId').val(response.loginId);
                $('#FullName').val(response.fullName);
                $('#Email').val(response.email);
                $('#passwordDiv').hide();
                
                 $('#userModal').text("Edit User")

                $('#addUserModal').modal('show');
            },

            error: function() {
                alert('Unable to load entry.');
            }
        });
    });
</script>
